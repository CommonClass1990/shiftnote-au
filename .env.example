# ============================================================================
# ShiftNote AU - Environment Configuration (.env.example)
# ============================================================================

# 1. Google Gemini API (Required for Voice-to-NDIS Extraction via gemini-4-argon)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. App URL (Used for OAuth callbacks and email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Supabase (PostgreSQL + Row-Level Security + Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. Resend API (Direct Plan Manager GST-Free Tax Invoice Emailing)
RESEND_API_KEY="re_123456789_YourResendApiKey"
RESEND_FROM_EMAIL="ShiftNote AU Invoicing <invoices@shiftnote.com.au>"

# 5. Xero OAuth2 Integration (Australian GST-Free ACCREC Invoicing)
XERO_CLIENT_ID="your-xero-oauth2-client-id"
XERO_CLIENT_SECRET="your-xero-oauth2-client-secret"
XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"
